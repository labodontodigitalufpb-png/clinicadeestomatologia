# Credenciais OAuth criadas no Google Cloud. Nunca use o prefixo VITE_ nestas variáveis.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legado/opcional: novas conexões salvam o token criptografado no Supabase.
GOOGLE_REFRESH_TOKEN=
# Segredo longo, aleatório e estável, usado no state OAuth e na criptografia do token.
# Ao trocar este segredo, reconecte a conta pelo painel.
GOOGLE_STATE_SECRET=
GOOGLE_REDIRECT_URI=https://clinicadeestomatologia.vercel.app/api/google/callback
# Opcional: pasta já autorizada ao aplicativo e com permissão de criação.
# Um ID de pasta arbitrária não concede acesso com drive.file.
# Sem este valor, o app cria sua própria pasta raiz.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Valores públicos do projeto Supabase (seguros para uso no frontend).
VITE_SUPABASE_URL=https://lrporteiwhokhdzxcakl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Somente backend/Vercel. Nunca use VITE_ nesta chave.
SUPABASE_SECRET_KEY=
